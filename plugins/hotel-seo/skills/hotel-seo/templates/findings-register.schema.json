{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hotel-seo findings register",
  "description": "One file per hotel per run: <hotel dir>/findings-register-<date>.json (a single-hotel site: <domain>/; a group hotel: <domain>/hotels/<slug>/). Every finding comes from a check ID in references/audit-checks.md; coverage gives every check ID a result. Re-checks update the same records instead of adding new ones.",
  "type": "object",
  "required": ["hotel", "site", "date", "registry_version", "coverage", "findings"],
  "properties": {
    "hotel": {"type": "string"},
    "site": {"type": "string", "description": "e.g. https://hotel.com"},
    "date": {"type": "string", "description": "YYYY-MM-DD, hotel's time zone"},
    "registry_version": {"type": "string", "description": "From the top of audit-checks.md, e.g. \"1.0\""},
    "hotel_path": {"type": ["string", "null"], "description": "Group sites: this hotel's path prefix(es) from site.json (e.g. /gewan-hotel-cairo/); null on a single-hotel site"},
    "sources": {
      "type": "object",
      "description": "What each source covered this run, e.g. {\"crawl\": \"crawl-2026-10-19, 214 pages\", \"gsc\": \"2026-07-19..2026-10-17 vs previous 90\", \"ga4\": \"property 123, last 90 days\", \"mirai\": \"1 Mar..19 Oct, 412 bookings\", \"keyword_planner\": \"not available\"}",
      "additionalProperties": {"type": "string"}
    },
    "thresholds_changed": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Any threshold tuned from audit-checks.md section 3, with the reason"
    },
    "coverage": {
      "type": "object",
      "description": "Every check ID in the registry -> its result and a few words why",
      "additionalProperties": {
        "type": "object",
        "required": ["result"],
        "properties": {
          "result": {"enum": ["finding", "no_issue", "insufficient_data", "not_available", "not_applicable"]},
          "note": {"type": "string"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "check_id", "category", "finding_type", "title", "evidence", "verification_status",
                     "severity", "priority", "recommended_action", "success_criteria", "status"],
        "properties": {
          "id": {"type": "string", "description": "Stable across re-checks: <check_id>-<short slug>, e.g. T03-blog-canonicals"},
          "check_id": {"type": "string", "pattern": "^([TOGKLPHAMBCV]|AI)[0-9]{2}$"},
          "category": {"enum": ["technical_seo", "on_page", "search_console", "keyword_research", "internal_linking",
                                "performance", "hotel_specific", "ga4", "mirai", "backlinks", "content_strategy",
                                "verification", "ai_search"]},
          "finding_type": {"enum": ["issue", "opportunity", "measurement_integrity"]},
          "title": {"type": "string"},
          "affected_urls": {"type": "array", "items": {"type": "string"}},
          "url_group": {
            "type": "object",
            "description": "For template / sitewide findings instead of hundreds of URLs",
            "properties": {"pattern": {"type": "string"}, "count": {"type": "integer"}, "examples": {"type": "array", "items": {"type": "string"}}}
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "observed_value"],
              "properties": {
                "source": {"type": "string", "description": "Tool and field, e.g. audit_site:report.canonical_targets, gsc:query+page, mirai_reservations:by_room_type"},
                "field": {"type": "string"},
                "observed_value": {},
                "expected_value": {}
              }
            }
          },
          "observed_condition": {"type": "string", "description": "What the data shows, no interpretation"},
          "inferred_impact": {"type": "string", "description": "What it probably means for search or bookings"},
          "verification_status": {"enum": ["verified", "probable", "unverified", "not_applicable"]},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "score": {
            "type": "object",
            "description": "score = round(((impact*0.4 + confidence*0.3 + reach*0.3) * 20) / (1 + effort*0.15))",
            "properties": {
              "impact": {"type": "integer", "minimum": 1, "maximum": 5},
              "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
              "reach": {"type": "integer", "minimum": 1, "maximum": 5},
              "effort": {"type": "integer", "minimum": 1, "maximum": 5},
              "value": {"type": "integer"}
            }
          },
          "impact": {
            "type": "object",
            "properties": {
              "type": {"type": "string", "description": "indexing, rankings, ctr, bookings, credibility, tracking, security..."},
              "business_relevance": {"enum": ["high", "medium", "low"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "recommended_action": {
            "type": "object",
            "required": ["action_type", "instructions"],
            "properties": {
              "action_type": {"type": "string", "description": "e.g. update_canonical, rewrite_title, add_redirect, noindex, fix_booking_link, replace_schema_block, add_internal_link, web_team_fix, ask_hotel"},
              "target_url": {"type": "string"},
              "instructions": {"type": "string", "description": "Exact, or 'see <list> <section>' where the copy-paste text lives"},
              "requires_approval": {"type": "boolean", "description": "true for redirects, canonicals, robots, bulk noindex, bulk content"}
            }
          },
          "success_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "list": {"enum": ["Priority", "Nice-to-Have", "Web Team", "Hotel", "not_listed"]},
          "list_section": {"type": "string", "description": "e.g. C, or 4"},
          "not_listed_reason": {"type": "string"},
          "status": {"enum": ["open", "approved", "in_progress", "implemented", "verified", "rejected", "monitoring"]},
          "outcome_status": {"enum": ["not_measured", "too_early", "improved", "no_change", "worse", "insufficient_data"],
                             "description": "Kept apart from status: a live change is not a proven result"},
          "baseline_captured_at": {"type": ["string", "null"]},
          "implemented_at": {"type": ["string", "null"]},
          "verified_at": {"type": ["string", "null"]}
        }
      }
    }
  }
}
