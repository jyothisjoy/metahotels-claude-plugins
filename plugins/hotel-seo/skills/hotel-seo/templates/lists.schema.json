{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hotel-seo list",
  "description": "One Priority, Secondary, Web Team or Re-check list. Rendered to PDF by the render_lists_pdf tool. Text fields accept **bold**, *italic*, `exact text to paste`, and [CONFIRM] (shown in red); \\n is a line break.",
  "type": "object",
  "required": [
    "hotel",
    "site",
    "title",
    "date",
    "sections"
  ],
  "properties": {
    "hotel": {
      "type": "string",
      "description": "Full hotel name, e.g. \"Al Bahar Hotel & Resort\""
    },
    "short_name": {
      "type": "string",
      "description": "Used in the file name: \"25 - Al Bahar Priority SEO List (14 Oct).pdf\""
    },
    "site": {
      "type": "string",
      "description": "The hotel website with scheme, e.g. \"https://hotel.com\". Relative URLs in checks resolve against it."
    },
    "title": {
      "enum": [
        "Priority SEO List",
        "Nice-to-Have SEO List",
        "Secondary SEO List",
        "Web Team List",
        "Re-check"
      ],
      "description": "\"Nice-to-Have SEO List\" is the Secondary list (the agency knows it by that name); \"Secondary SEO List\" still renders for old files."
    },
    "date": {
      "type": "string",
      "description": "Day and month as the team writes it, e.g. \"14 Oct\""
    },
    "file_number": {
      "type": [
        "integer",
        "string"
      ],
      "description": "Running file number across all hotels (25, 26, 27...). \"auto\" = the highest number already in <work folder>/*/Reports + 1. Omit for no number."
    },
    "subtitle": {
      "type": "string",
      "description": "e.g. \"From MetaHotels · hotel.com · from Search Console + GA4 (last 3 months), Mirai, a full crawl (157 pages) and live checks on 14 Oct · about 3 hours 15 minutes · Priority — do the full list; then Nice-to-Have items once all Priority lists are done\""
    },
    "lead": {
      "type": "string",
      "description": "Green box under the header: the single biggest issue and why it matters for bookings now (season, revenue), with real numbers. Not checked by the [CONFIRM] guard: our own data only."
    },
    "summary": {
      "type": "object",
      "description": "The item list at the top. Priority uses letters (A, B, B2, C...), Nice-to-Have and Web Team use numbers. Default columns #, Task, Time render as a box without a header row. Re-check: #, Item, Status, Note (Done / Partly / Open / Waiting are coloured). A held item says so in its task text: \"Stay & Splash page [waiting for hotel details]\".",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "#",
            "Task",
            "Time"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "finish": {
          "type": "string",
          "description": "Finish row, e.g. \"LiteSpeed → Purge All → send MetaHotels the change list (mark items done only once live)\""
        }
      },
      "required": [
        "rows"
      ]
    },
    "warnings_top": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Red boxes under the summary, e.g. the offers and prices hold"
    },
    "working": {
      "type": "array",
      "description": "\"What's already working (no action)\" table: rows of [item, status, note], status \"OK\" (green). Things checked and fine, so the agency doesn't redo them and the hotel sees what's right. Not checked by the [CONFIRM] guard.",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 3,
        "maxItems": 3
      }
    },
    "intro": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paragraphs before the first section (Re-check: thanks + what's live)"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "number": {
            "type": [
              "string",
              "number"
            ],
            "description": "Priority: A, B, B2, C... · Nice-to-Have / Web Team: 1, 2, 3... · Re-check: A, B, C..."
          },
          "title": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "description": "e.g. \"30 min\""
          },
          "why": {
            "type": "string",
            "description": "One or two lines with real numbers, rendered in italics under the heading: what is wrong now and what it costs in bookings or search."
          },
          "blocks": {
            "type": "array",
            "items": {
              "description": "Exactly one key per block.",
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "p"
                  ],
                  "properties": {
                    "p": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "ol"
                  ],
                  "properties": {
                    "ol": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "ul"
                  ],
                  "properties": {
                    "ul": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "table"
                  ],
                  "properties": {
                    "table": {
                      "type": "object",
                      "required": [
                        "columns",
                        "rows"
                      ],
                      "properties": {
                        "columns": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "rows": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": [
                                "string",
                                "number"
                              ]
                            }
                          }
                        }
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Shown verbatim in a grey box (schema, redirect rules, robots.txt, title templates)"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "warning"
                  ],
                  "properties": {
                    "warning": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "note"
                  ],
                  "properties": {
                    "note": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "paste"
                  ],
                  "properties": {
                    "paste": {
                      "type": "string",
                      "description": "Green box: prose the agency pastes as-is (a paragraph for the end of blog posts, an FAQ answer). Mark links as __linked words__ [→ /path/]."
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "h3"
                  ],
                  "properties": {
                    "h3": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "description": "One machine-checkable condition that is true once the item is done. recheck_list runs them against the live site. url: a path like \"/dining/\" or \"sitewide\" (every page of the recheck crawl) for text_absent / link_absent.",
              "oneOf": [
                {
                  "properties": {
                    "type": {
                      "const": "title"
                    },
                    "url": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "url",
                    "expected"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "meta"
                    },
                    "url": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "url",
                    "expected"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "h1"
                    },
                    "url": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string",
                      "description": "Passes only if it is the single H1"
                    }
                  },
                  "required": [
                    "url",
                    "expected"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "h1_count"
                    },
                    "url": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "integer",
                      "default": 1
                    }
                  },
                  "required": [
                    "url"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "redirect"
                    },
                    "source": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "source",
                    "expected"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "status"
                    },
                    "url": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "url",
                    "expected"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "canonical"
                    },
                    "url": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "url",
                    "expected"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "noindex"
                    },
                    "url": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "boolean",
                      "default": true
                    }
                  },
                  "required": [
                    "url"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "text_absent"
                    },
                    "url": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "visible_only": {
                      "type": "boolean",
                      "default": true
                    }
                  },
                  "required": [
                    "url",
                    "text"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "text_present"
                    },
                    "url": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "url",
                    "text"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "link_absent"
                    },
                    "url": {
                      "type": "string"
                    },
                    "href": {
                      "type": "string",
                      "description": "Substring of the href"
                    }
                  },
                  "required": [
                    "url",
                    "href"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "alt"
                    },
                    "url": {
                      "type": "string"
                    },
                    "image": {
                      "type": "string",
                      "description": "Substring of the image src (file name)"
                    },
                    "expected": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "url",
                    "image",
                    "expected"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "schema_count"
                    },
                    "url": {
                      "type": "string"
                    },
                    "schema_type": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "url",
                    "schema_type",
                    "expected"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "link_present"
                    },
                    "url": {
                      "type": "string"
                    },
                    "href": {
                      "type": "string",
                      "description": "Substring of the href, e.g. the booking-engine link added to a blog post"
                    }
                  },
                  "required": [
                    "url",
                    "href"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "manual"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "description"
                  ]
                }
              ]
            },
            "description": "Every Priority and Secondary item gets checks covering each change it asks for; use manual only for what cannot be fetched (plugin settings, Search Console, Bing)."
          },
          "hold": {
            "type": "string",
            "description": "The item waits on someone else, shown in orange after the title, e.g. \"waiting for hotel details\" or \"waiting for hotel confirmation\". Say exactly what is needed. Recheck reports it as Waiting, not Open."
          },
          "not_priority_because": {
            "type": "string",
            "description": "Only on Nice-to-Have / Web Team sections that touch the homepage, rooms, offers, contact or booking path: why it is deliberately not on the Priority list (e.g. \"cosmetic: wording only\"). Silences the renderer's severity warning."
          }
        }
      }
    },
    "warnings_end": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "footer": {
      "type": "string",
      "description": "Defaults to \"When done: LiteSpeed → Purge All → send MetaHotels the change list (mark items done only once they are live). We will re-crawl and check every item.\""
    }
  }
}