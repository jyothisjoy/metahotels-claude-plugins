<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc.hotel }}: {{ doc.name }} ({{ doc.date }})</title>
<style>{{ css }}</style>
</head>
<body>
<header class="doc-head">
  <h1>{{ doc.hotel }}: {{ doc.name }} — {{ doc.date }}</h1>
  {% if doc.subtitle %}<p class="sub">{{ doc.subtitle | rich }}</p>{% endif %}
</header>

{% if doc.lead %}<div class="lead">{{ doc.lead | rich }}</div>{% endif %}

{% if doc.summary %}
<table class="grid summary{% if not doc.summary.show_header %} boxed{% endif %}">
  {% if doc.summary.show_header %}<thead><tr>{% for c in doc.summary.columns %}<th>{{ c }}</th>{% endfor %}</tr></thead>{% endif %}
  <tbody>
  {% for row in doc.summary.rows %}
    <tr>{% for cell in row %}<td class="{{ cell | status_class }}">{{ cell | rich }}</td>{% endfor %}</tr>
  {% endfor %}
  {% if doc.summary.finish %}
    <tr class="finish"><td></td><td colspan="{{ doc.summary.columns | length - 1 }}"><strong>Finish:</strong> {{ doc.summary.finish | rich }}</td></tr>
  {% endif %}
  </tbody>
</table>
{% endif %}

{% for w in doc.warnings_top %}<div class="warning">{{ w | rich }}</div>{% endfor %}

{% if doc.working %}
<section>
  <h2><span>What's already working (no action)</span></h2>
  <table class="grid working">
    <thead><tr><th>Item</th><th>Status</th><th>Note</th></tr></thead>
    <tbody>{% for row in doc.working %}<tr>{% for cell in row %}<td class="{{ cell | status_class }}">{{ cell | rich }}</td>{% endfor %}</tr>{% endfor %}</tbody>
  </table>
</section>
{% endif %}

{% if doc.parity %}
<section>
  <h2><span>{{ doc.parity.title or 'Rate parity (Best Rate calendar)' }}</span></h2>
  <table class="grid">
    <thead><tr>{% for c in doc.parity.columns %}<th>{{ c }}</th>{% endfor %}</tr></thead>
    <tbody>{% for row in doc.parity.rows %}<tr>{% for cell in row %}<td>{{ cell | rich }}</td>{% endfor %}</tr>{% endfor %}</tbody>
  </table>
  {% if doc.parity.note %}<p class="why">{{ doc.parity.note | rich }}</p>{% endif %}
</section>
{% endif %}

{% if doc.intro %}{% for p in doc.intro %}<p>{{ p | rich }}</p>{% endfor %}{% endif %}

{% for s in doc.sections %}
<section>
  <h2><span>{% if s.number %}{{ s.number }}. {% endif %}{{ s.title | rich }}{% if s.hold %} <span class="hold">[{{ s.hold }}]</span>{% endif %}</span>{% if s.time %}<span class="time">{{ s.time }}</span>{% endif %}</h2>
  {% if s.why %}<p class="why">{{ s.why | rich }}</p>{% endif %}
  {% for b in s.blocks %}{% include "block.html.j2" %}{% endfor %}
</section>
{% endfor %}

{% for w in doc.warnings_end %}<div class="warning">{{ w | rich }}</div>{% endfor %}

{% if doc.footer %}<p class="footer-line">{{ doc.footer | rich }}</p>{% endif %}
</body>
</html>
